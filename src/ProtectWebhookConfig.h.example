#pragma once
// Copy to ProtectWebhookConfig.h (git-ignored) and fill in. Build with
// -DNUKI_HUB_PROTECT_WEBHOOK. All values below are placeholders: the build
// refuses them (static_assert) unless -DPROTECT_WEBHOOK_ALLOW_PLACEHOLDERS,
// which only CI uses. Other build-time checks: secret >= 32 chars, tokens >= 16,
// every rule has a device and an action, value needs field, value2 needs field2,
// and every rule has a token or key + value (see below).
//
// Written for UniFi SuperLink KeyFobs (USL-FOB) via Alarm Manager
// "Activity -> Button". Capture one real press first
// (scripts/protect_webhook_test.py listen) to confirm the fields below.

// Long random secret: set it as Protect's webhook "Bearer" auth (preferred) or
// append ?k=... to the Delivery URL. Generate with: openssl rand -hex 32
#define PROTECT_WEBHOOK_SECRET "replace-with-output-of-openssl-rand-hex-32-000000000000000000000"

// Only accept requests from the Protect console (UniFi OS) IP. "" disables the check.
#define PROTECT_WEBHOOK_SOURCE_IP "192.0.2.10"

// What a fob press looks like in the Alarm Manager webhook (UniFi Protect
// 7.2.105 source, service.js; same builder in Local and Global Alarm Manager
// mode; not yet confirmed by a live capture):
//   {"alarm":{"name":..,"sources":[{"device":"AABBCCDDEEFF","type":"include","buttons":["right"]}],
//             "conditions":[{"condition":{"type":"is","source":"sensor_button_pressed","value":"longPress"}}],
//             "triggers":[{"key":"sensor_button_pressed","value":"longPress",
//                          "device":"AABBCCDDEEFF","button":"right","eventId":..,"timestamp":..}]},
//    "timestamp":..}
//   button: arm (top left) | night (top right) | disarm (bottom left) |
//           panic (bottom right) | left | right
//   value:  press | longPress (the app's "Hold", 3 s) | doublePress
//
// Defence in depth: one Alarm Manager alarm per button+gesture, each with its
// own URL token (Protect filters), AND check key/button/gesture here.
//     Delivery URL: http://<board>/protect?r=<token>
//     Auth: Bearer <PROTECT_WEBHOOK_SECRET>   (or append &k=<secret> to the URL)
//
// Rule fields (nullptr = not checked):
//   token    per-alarm URL token (?r=...), openssl rand -hex 16
//   key      triggers[].key                      "sensor_button_pressed"
//   device   triggers[].device = the fob's MAC    (required; separators/case ignored)
//   field    trigger field naming the button      "button"
//   value    expected button                      e.g. "right"
//   field2   trigger field naming the gesture     "value"
//   value2   expected gesture                     e.g. "longPress"
//   action   Nuki Hub lock action: "unlock", "lock", "unlatch", "lockngo", ...
//            still subject to Nuki Hub's "Nuki Lock Access Control" ACL.
//            Or, on the Waveshare 8DI-8RO build, "relay1".."relay8": close that
//            relay for PROTECT_WEBHOOK_RELAY_PULSE_MS (e.g. wired across an
//            intercom's door-open button). The ACL doesn't apply to relays.
//            Prefer "unlock" over "unlatch": a timed-out command is retried,
//            and a repeated unlock is harmless where a repeated unlatch is not.
// A rule with neither token nor key+value would match ANY event from that fob;
// the build refuses it unless -DPROTECT_WEBHOOK_ALLOW_BROAD_RULES.
// An unknown action disables the whole route at boot (logged).
struct ProtectRule
{
    const char* token;
    const char* key;
    const char* device;
    const char* field;
    const char* value;
    const char* field2;
    const char* value2;
    const char* action;
};

// Must be "static constexpr" so the build-time checks can read it.
static constexpr ProtectRule PROTECT_WEBHOOK_RULES[] = {
    // Alarm "Fob A - Hold Right" -> unlock (a 3 s hold is hard to trigger in a pocket)
    { "replace-with-32-hex-token-hold-right", "sensor_button_pressed", "AA:BB:CC:DD:EE:01",
      "button", "right", "value", "longPress", "unlock" },
    // Alarm "Fob A - Press Right" -> lock
    { "replace-with-32-hex-token-press-right", "sensor_button_pressed", "AA:BB:CC:DD:EE:01",
      "button", "right", "value", "press", "lock" },
};

// Reject events whose Protect timestamp is further than this from our (NTP) clock.
#define PROTECT_WEBHOOK_MAX_SKEW_MS 15000

// Minimum time between two accepted events for the same rule. Different rules
// (e.g. hold-to-unlock, then press-to-lock) have separate cooldowns.
#define PROTECT_WEBHOOK_COOLDOWN_MS 10000

// A queued action that hasn't been sent to the lock within this time (first
// attempt or any retry, e.g. lock out of BLE range) is dropped, so a press
// can't open the door much later. An attempt already in progress still completes.
#define PROTECT_WEBHOOK_ACTION_DEADLINE_MS 8000

// If the nuki task (BLE) hasn't looped or started a BLE attempt for this long
// when a matching press arrives, reply 503 ble_stalled and reboot the board.
#define PROTECT_WEBHOOK_BLE_STALL_MS 30000

// How long a "relayN" action keeps the relay closed (Waveshare 8DI-8RO build).
#define PROTECT_WEBHOOK_RELAY_PULSE_MS 3000
