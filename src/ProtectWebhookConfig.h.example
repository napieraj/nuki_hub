#pragma once
// Copy to ProtectWebhookConfig.h (git-ignored) and fill in. Build with
// -DNUKI_HUB_PROTECT_WEBHOOK. All values below are placeholders.
//
// Written for UniFi SuperLink KeyFobs (USL-FOB) via Alarm Manager
// "Activity -> Button". Capture one real press first
// (scripts/protect_webhook_test.py listen) to confirm the fob's device value.

// Long random secret, passed as ?k=... in the Protect "Delivery URL".
// Generate with: openssl rand -hex 32
#define PROTECT_WEBHOOK_SECRET "replace-with-64-hex-chars"

// Only accept requests from the Protect console (UniFi OS) IP. "" disables the check.
#define PROTECT_WEBHOOK_SOURCE_IP "192.0.2.10"

// What is documented (Protect Integration API spec 7.2.105):
//   - fob button presses are "sensorButtonPressed" events whose
//     metadata.button.text is arm | disarm | night | panic | left | right
//     (top-left, bottom-left, top-right, bottom-right, L, R). No gesture field.
// What is NOT documented: how an Alarm Manager "Activity -> Button" trigger
// encodes the button (and Press/Hold/Double) in the webhook body.
//
// Recommended: let Protect filter. Create ONE Alarm Manager alarm per
// button+gesture you use, each with its own Delivery URL token
//     http://<board>/protect?k=<secret>&r=<token>
// and match here on token + fob only. Nothing undocumented is parsed.
//
// Rule fields (nullptr = not checked):
//   token    per-alarm URL token (?r=...), openssl rand -hex 16
//   key      triggers[].key                     (only if you captured it)
//   device   triggers[].device = the fob's MAC   (required; separators/case ignored)
//   field    trigger field naming the button     (only if you captured it)
//   value    expected content of field
//   field2   second field, e.g. the gesture
//   value2   expected content of field2
//   action   Nuki Hub lock action: "unlock", "unlatch", "lock", "lockngo", ...
//            still subject to Nuki Hub's "Nuki Lock Access Control" ACL
// A rule with neither token nor key+value matches ANY event from that fob.
struct ProtectRule
{
    const char* token;
    const char* key;
    const char* device;
    const char* field;
    const char* value;
    const char* field2;
    const char* value2;
    const char* action;
};

static const ProtectRule PROTECT_WEBHOOK_RULES[] = {
    // Alarm "Fob A - Hold Right" -> unlock (a hold is hard to trigger in a pocket)
    { "replace-with-32-hex-token-hold-right", nullptr, "AA:BB:CC:DD:EE:01",
      nullptr, nullptr, nullptr, nullptr, "unlock" },
    // Alarm "Fob A - Press Right" -> lock
    { "replace-with-32-hex-token-press-right", nullptr, "AA:BB:CC:DD:EE:01",
      nullptr, nullptr, nullptr, nullptr, "lock" },
};

// Reject events whose Protect timestamp is further than this from our (NTP) clock.
#define PROTECT_WEBHOOK_MAX_SKEW_MS 15000

// Minimum time between two accepted actions.
#define PROTECT_WEBHOOK_COOLDOWN_MS 10000
